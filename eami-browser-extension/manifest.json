{
  "manifest_version": 3,
  "name": "EAMI Paste Detection",
  "version": "1.0.0",
  "description": "Detects paste events into known AI-tool web UIs (ChatGPT, Claude, Copilot, Gemini, Perplexity, Poe) and relays destination domain, timestamp, content length, and a content hash -- never the pasted text itself -- to the EAMI endpoint agent for enterprise AI-usage visibility.",
  "key": "",
  "permissions": ["storage", "alarms", "nativeMessaging"],
  "host_permissions": [
    "https://*.chat.openai.com/*",
    "https://*.claude.ai/*",
    "https://*.copilot.microsoft.com/*",
    "https://*.gemini.google.com/*",
    "https://*.perplexity.ai/*",
    "https://*.poe.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.chat.openai.com/*",
        "https://*.claude.ai/*",
        "https://*.copilot.microsoft.com/*",
        "https://*.gemini.google.com/*",
        "https://*.perplexity.ai/*",
        "https://*.poe.com/*"
      ],
      "js": ["domains.js", "content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}

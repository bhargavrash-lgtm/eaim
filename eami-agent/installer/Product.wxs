<?xml version="1.0" encoding="UTF-8"?>
<!--
  EAMI Agent - WiX v4 Installer Source
  ======================================
  Toolchain : WiX Toolset v4  (https://wixtoolset.org)
  Target    : Windows x64 (AMD64)

  BUILD LOCALLY
  =============
  1. Install WiX v4 (requires .NET SDK 6+):
       dotnet tool install -g wix

  2. Run the PowerShell build script from the repo root:
       .\eami-agent\installer\build.ps1 -Version 1.0.0

     Or call wix directly:
       wix build eami-agent\installer\Product.wxs
           -arch x64
           -d Version=1.0.0
           -d BinaryPath=eami-agent\eami-agent-windows-amd64.exe
           -o eami-agent-1.0.0-windows-amd64.msi

  SILENT INSTALL (SCCM / Intune / manual)
  ========================================
  msiexec /i eami-agent-1.0.0-windows-amd64.msi /qn
      COLLECTOR_URL=https://collector.corp.internal:8888
      COLLECTOR_API_KEY=eami_k_your_key_here

  UNINSTALL
  =========
  msiexec /x eami-agent-1.0.0-windows-amd64.msi /qn

  GROUP POLICY
  ============
  See installer/README.md for full GP and Intune deployment instructions.

  REGISTRY KEYS WRITTEN
  =====================
  HKLM\SOFTWARE\EAMI\Agent\
    CollectorUrl       (REG_SZ)    value of COLLECTOR_URL property
    CollectorApiKey    (REG_SZ)    value of COLLECTOR_API_KEY property
    InstallDir         (REG_SZ)    resolved install directory
    Version            (REG_SZ)    MSI version string
    IntervalSeconds    (REG_DWORD) scan interval (default 300)

  WINDOWS SERVICE
  ===============
  Name        : EAMIAgent
  Display     : EAMI Endpoint Agent
  Start type  : Automatic (starts on boot)
  Account     : LocalSystem
  Lifecycle   : started on install, stopped on upgrade/uninstall, deleted on uninstall

  NOTE (ADR-014): The agent binary reads COLLECTOR_URL and COLLECTOR_API_KEY from the
  registry keys above. This requires the registry-fallback feature in
  eami-agent/internal/config/ (owned by BE-Collector). Until that is implemented,
  the binary must be started manually or the YAML config must be edited separately.

  NATIVE MESSAGING HOST (paste-detection groundwork, B0)
  =======================================================
  On install, runs eami-agent.exe's register-native-messaging install
  command (exact syntax in the CustomAction ExeCommand attributes below),
  which (see internal/nmregister/nmregister_windows.go):
    1. Creates a hard-linked launcher copy, eami-agent-nmhost.exe, next to
       the real binary (same file, zero extra disk space, can't fall out
       of sync on upgrade).
    2. Writes a native-messaging manifest whose "path" points at that
       launcher, NOT eami-agent.exe directly.
    3. Points both Chrome's and Edge's NativeMessagingHosts registry keys
       at the manifest.
  On uninstall, runs the register-native-messaging uninstall command,
  which removes both registry keys, the manifest file, and the launcher
  hard link (none of the three are declared as WiX File/Component entries
  below, since they're generated dynamically, not laid down by the MSI
  itself — nothing else would clean them up).

  Why the launcher indirection: Chrome/Edge's native-messaging manifest
  schema has no "args" field — the browser execs whatever "path" names
  with only its own fixed arguments, never anything the manifest supplies.
  A manifest pointing straight at eami-agent.exe would make the browser
  launch it with no native-messaging-host flag argument, silently falling
  through to the ordinary poll loop instead of acting as a host. eami-agent
  detects invocation under the launcher's name and behaves as if the flag
  had been passed explicitly (cmd/agent/main.go's
  invokedAsNativeMessagingLauncher). Caught by code review before any real
  extension existed to catch it in practice.

  This manifest's allowed_origins is scoped to a PLACEHOLDER extension ID
  (internal/nmregister's AllowedExtensionID) — there is no B1 (browser
  extension) yet, so this host cannot actually be invoked by anything
  until that placeholder is replaced with a real, published extension ID.
  Even once it is, cmd/agent/main.go's parent-process check
  (internal/nmlauncher) refuses to serve any message unless the immediate
  parent process is a recognized browser executable — defense-in-depth
  against a different local process invoking this mode directly.

  NOTE: this custom-action wiring is real WiX v4 source, verified with a
  real local `wix build` after a build failure caught an XML-comment
  syntax error in an earlier draft of this very comment block (a repeated
  hyphen pair used as a dash, invalid inside XML comments — ironic, given
  the topic). The registration logic itself (nmregister.Install/Uninstall)
  was separately verified directly against this machine's real registry
  by invoking the built exe with the register-native-messaging
  install/uninstall commands outside the MSI.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="EAMI Agent"
    Manufacturer="EAMI"
    Version="$(var.Version)"
    UpgradeCode="9E8F7D6C-5B4A-3210-FEDC-BA9876543210"
    Scope="perMachine">

    <SummaryInformation
      Description="EAMI AI asset discovery endpoint agent"
      Keywords="EAMI;AI;monitoring;agent;endpoint" />

    <!--
      MajorUpgrade: installing a newer version automatically removes the old one.
      AllowSameVersionUpgrades set to no - use /x then /i to reinstall same version.
    -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of EAMI Agent is already installed. Uninstall it first." />

    <!-- Embed all files in a single CAB inside the MSI -->
    <MediaTemplate EmbedCab="yes" />

    <!--
      Public install-time properties.
      Passed via: msiexec /i eami-agent.msi COLLECTOR_URL=... COLLECTOR_API_KEY=...
      Both values are written to HKLM\SOFTWARE\EAMI\Agent on install.
    -->
    <!--
      Secure="yes" replaces the WiX3 SecureCustomProperties pattern — it forwards
      the property from the user session to the elevated server session automatically,
      which is required for silent installs via SCCM or Intune.
    -->
    <Property Id="COLLECTOR_URL" Value="http://localhost:8888" Secure="yes" />
    <Property Id="COLLECTOR_API_KEY" Secure="yes" />

    <!--
      Directory layout: C:\Program Files\EAMI\Agent\
    -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="EAMI_DIR" Name="EAMI">
        <Directory Id="INSTALLFOLDER" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <!-- Single installable feature containing all components -->
    <Feature Id="ProductFeature" Title="EAMI Agent" Level="1">
      <ComponentRef Id="AgentBinary" />
      <ComponentRef Id="AgentConfig" />
    </Feature>

    <!--
      Component: agent binary + Windows Service.
      KeyPath: eami-agent.exe (presence of this file = component installed).
    -->
    <DirectoryRef Id="INSTALLFOLDER">

      <Component Id="AgentBinary" Guid="*">
        <File
          Id="AgentExe"
          Source="$(var.BinaryPath)"
          Name="eami-agent.exe"
          KeyPath="yes"
          Checksum="yes" />

        <!--
          Windows Service: EAMIAgent
          Type="ownProcess"    runs as its own process (not shared svchost)
          Start="auto"         Automatic - survives reboots
          ErrorControl="normal" SCM logs the failure but continues boot
          Account="LocalSystem" sufficient for registry reads and local file access
        -->
        <ServiceInstall
          Id="EAMIAgentSvc"
          Name="EAMIAgent"
          DisplayName="EAMI Endpoint Agent"
          Description="EAMI AI asset discovery agent - monitors AI apps, models, and MCP servers on this endpoint and reports to the on-prem collector."
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="LocalSystem"
          Interactive="no" />

        <!--
          Service control actions tied to MSI install sequences:
          Start="install"    start service after InstallServices action
          Stop="both"        stop before upgrade (reinstall) and before uninstall
          Remove="uninstall" delete service entry on uninstall
          Wait="yes"         block until SCM confirms the action completed
        -->
        <ServiceControl
          Id="EAMIAgentSvcCtrl"
          Name="EAMIAgent"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />

      </Component>

      <!--
        Component: registry configuration.
        Writes COLLECTOR_URL, COLLECTOR_API_KEY, and metadata to
        HKLM\SOFTWARE\EAMI\Agent at install time.
        On uninstall, WiX removes all values and the key itself.

        KeyPath: CollectorUrl registry value.
        If this value exists then this component is considered installed.

        [COLLECTOR_URL] and [COLLECTOR_API_KEY] are MSI property references.
        At install time these resolve to the values passed on the command line
        (or the property defaults if not provided).
      -->
      <Component Id="AgentConfig" Guid="*">
        <RegistryKey Root="HKLM" Key="SOFTWARE\EAMI\Agent">

          <RegistryValue
            Name="CollectorUrl"
            Value="[COLLECTOR_URL]"
            Type="string"
            KeyPath="yes" />

          <RegistryValue
            Name="CollectorApiKey"
            Value="[COLLECTOR_API_KEY]"
            Type="string" />

          <!-- Absolute install path - useful for diagnostic scripts -->
          <RegistryValue
            Name="InstallDir"
            Value="[INSTALLFOLDER]"
            Type="string" />

          <!-- MSI version - shown in Add/Remove Programs and useful for auditing -->
          <RegistryValue
            Name="Version"
            Value="$(var.Version)"
            Type="string" />

          <!-- Scan interval in seconds (default 300 = every 5 minutes) -->
          <RegistryValue
            Name="IntervalSeconds"
            Value="300"
            Type="integer" />

        </RegistryKey>
      </Component>

    </DirectoryRef>

    <!--
      Custom actions: register/unregister the native-messaging manifest by
      invoking the just-installed binary itself (AgentExe, above) with the
      register-native-messaging install|uninstall commands (exact syntax
      in ExeCommand below; see internal/nmregister/nmregister_windows.go).
      Deferred + Impersonate="no"
      since writing HKLM registry keys needs elevated context, the same
      reason ServiceInstall/ServiceControl above run elevated.

      Sequencing follows the standard WiX idiom for "run once on a fresh
      install, once on a genuine uninstall" — NOT Installed / Installed AND
      NOT UPGRADINGPRODUCTCODE — so a MajorUpgrade's own remove-then-install
      of the new version doesn't unregister and immediately re-register on
      every upgrade.
    -->
    <CustomAction
      Id="RegisterNativeMessaging"
      FileRef="AgentExe"
      ExeCommand="--register-native-messaging install"
      Execute="deferred"
      Impersonate="no"
      Return="check" />

    <CustomAction
      Id="UnregisterNativeMessaging"
      FileRef="AgentExe"
      ExeCommand="--register-native-messaging uninstall"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterNativeMessaging" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="UnregisterNativeMessaging" Before="RemoveFiles" Condition="Installed AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

  </Package>
</Wix>

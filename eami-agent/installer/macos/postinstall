#!/bin/bash
# postinstall — runs as root after pkg payload is extracted
#
# This script is invoked by macOS Installer after the files have been placed.
# It is also called by MDM systems (Jamf Pro, Mosyle, Kandji) as a postinstall
# action. When invoked by Jamf, script parameters $4 and $5 carry the
# COLLECTOR_URL and COLLECTOR_API_KEY values respectively.
#
# Config resolution order:
#   1. Jamf-style positional args: $4 = COLLECTOR_URL, $5 = COLLECTOR_API_KEY,
#      $6 = COLLECTOR_CA_CERT_PATH (B-072, optional)
#   2. Environment variables:      EAMI_COLLECTOR_URL, EAMI_COLLECTOR_API_KEY,
#      EAMI_COLLECTOR_CA_CERT_PATH
#   3. Fallback placeholder values (operator must edit /etc/eami/agent.yaml)
#
# COLLECTOR_CA_CERT_PATH (B-072): only needed when the collector's TLS
# certificate is the appliance's own default self-signed one (eami-proxy's
# Caddy, B-071/B-072) rather than a real, publicly-trusted certificate.
# Points at a CA cert file already staged on this machine (matches the
# Windows/Linux installers' identical path-based approach, not inline PEM
# content -- see appliance/README.md's "TLS certificates for
# eami-collector" section).
#
# SECURITY (a real finding from this brief's own mandatory security
# review, fixed before shipping): stage this file somewhere NOT
# world-writable -- e.g. wherever your MDM (Jamf/Mosyle/Kandji) already
# places other install-time payload files, never a shared directory like
# /tmp. This script independently verifies the source file's
# ownership/permissions before trusting it and refuses to proceed if they
# look wrong, but a safe staging location is still the real first line of
# defense.

set -e

# ── Resolve config values ────────────────────────────────────────────────────
# $4/$5/$6 are Jamf Pro script parameter conventions (parameters 4-6 in
# the Jamf policy → Scripts → Script Parameters fields).
COLLECTOR_URL="${4:-${EAMI_COLLECTOR_URL:-http://localhost:8888}}"
COLLECTOR_API_KEY="${5:-${EAMI_COLLECTOR_API_KEY:-REPLACE_WITH_YOUR_API_KEY}}"
COLLECTOR_CA_CERT_PATH="${6:-${EAMI_COLLECTOR_CA_CERT_PATH:-}}"

# ── Write agent config ────────────────────────────────────────────────────────
mkdir -p /etc/eami
chmod 755 /etc/eami

# If a CA cert was supplied, copy it into /etc/eami so it survives even if
# the staged source path is cleaned up later -- agent.yaml then references
# this stable copy, not the original.
#
# SECURITY: verify ownership/permissions on the source file before
# trusting it (a real finding from this brief's own mandatory security
# review) -- this script runs as root, and without this check, a local
# unprivileged attacker who can write to whatever path an admin documents
# (e.g. a shared directory like /tmp) could pre-plant their own CA there
# before the real install runs, and this script would silently copy and
# permanently trust it. Requiring the source to be root-owned and not
# group/other-writable means an attacker would need root already to plant
# it -- at which point they don't need this attack at all.
CA_CERT_YAML_PATH=""
if [ -n "$COLLECTOR_CA_CERT_PATH" ]; then
    if [ ! -f "$COLLECTOR_CA_CERT_PATH" ]; then
        echo "eami-agent: WARNING -- COLLECTOR_CA_CERT_PATH=$COLLECTOR_CA_CERT_PATH does not exist, skipping (agent will use the OS default trust store)" >&2
    else
        # BSD stat (macOS) uses -f, unlike GNU stat's -c.
        owner_uid="$(stat -f '%u' "$COLLECTOR_CA_CERT_PATH")"
        perm="$(stat -f '%Lp' "$COLLECTOR_CA_CERT_PATH")"
        # Bitwise, not numeric-magnitude, comparison -- see the Linux
        # postinstall.sh's identical check for why (a mode like 624 is
        # numerically less than 644 but still group-writable).
        group_digit="${perm: -2:1}"
        other_digit="${perm: -1:1}"
        if [ "$owner_uid" != "0" ]; then
            echo "eami-agent: ERROR -- COLLECTOR_CA_CERT_PATH=$COLLECTOR_CA_CERT_PATH is not owned by root; refusing to trust it (stage the CA cert from a location only root can write to, not a shared directory like /tmp)" >&2
        elif [ $(( group_digit & 2 )) -ne 0 ] || [ $(( other_digit & 2 )) -ne 0 ]; then
            echo "eami-agent: ERROR -- COLLECTOR_CA_CERT_PATH=$COLLECTOR_CA_CERT_PATH is group- or world-writable (mode $perm); refusing to trust it" >&2
        else
            cp "$COLLECTOR_CA_CERT_PATH" /etc/eami/collector-ca.pem
            chmod 644 /etc/eami/collector-ca.pem
            CA_CERT_YAML_PATH="/etc/eami/collector-ca.pem"
            echo "eami-agent: collector CA cert copied to /etc/eami/collector-ca.pem"
        fi
    fi
fi

cat > /etc/eami/agent.yaml <<EOF
agent:
  id: "$(hostname)"
  interval_secs: 300
  log_level: info

collector:
  url: "${COLLECTOR_URL}"
  api_key: "${COLLECTOR_API_KEY}"
  ca_cert_path: "${CA_CERT_YAML_PATH}"
  timeout_seconds: 30

detection:
  model_file_scan_paths: []
  model_file_size_mb: 100
EOF

chmod 600 /etc/eami/agent.yaml
echo "eami-agent: config written to /etc/eami/agent.yaml"

# ── Register the native-messaging host (paste-detection groundwork) ─────────
# No registry step on macOS (that's Windows-only, see internal/nmregister)
# -- Chrome discovers native messaging hosts by finding a manifest JSON
# file in a well-known, system-wide directory.
#
# The manifest's "path" points at a hard-linked launcher copy of the real
# binary, NOT /usr/local/bin/eami-agent directly -- Chrome's manifest
# schema has no field to pass --native-messaging-host as an argument, so
# the browser would otherwise launch the real binary in ordinary poll-loop
# mode instead of host mode (caught by code review before any real
# extension existed to catch it in practice). eami-agent detects
# invocation under this launcher's name and behaves as if
# --native-messaging-host had been passed explicitly -- see
# nmregister.LauncherBaseName's doc comment.
ln -f /usr/local/bin/eami-agent /usr/local/bin/eami-agent-nmhost

# allowed_origins is B1's real, stable extension ID -- eami-browser-extension's
# manifest.json pins this via its "key" field; see
# eami-browser-extension/README.md for the derivation.
NM_DIR="/Library/Google/Chrome/NativeMessagingHosts"
mkdir -p "$NM_DIR"
cat > "$NM_DIR/com.eami.agent.json" <<'EOF'
{
  "name": "com.eami.agent",
  "description": "EAMI Agent native messaging host (real-time paste-event relay)",
  "path": "/usr/local/bin/eami-agent-nmhost",
  "type": "stdio",
  "allowed_origins": [
    "chrome-extension://ngmdfnecljeoleiancdedbmhjdihaoaa/"
  ]
}
EOF
chmod 644 "$NM_DIR/com.eami.agent.json"
echo "eami-agent: native-messaging manifest registered for Chrome"

# ── Load launchd daemon ───────────────────────────────────────────────────────
PLIST="/Library/LaunchDaemons/io.eami.agent.plist"
chown root:wheel "$PLIST"
chmod 644 "$PLIST"

# Unload first if already loaded (handles reinstall / upgrade)
launchctl unload "$PLIST" 2>/dev/null || true
launchctl load "$PLIST"
echo "eami-agent: launchd service loaded — agent is running"

exit 0
